import pyautogui as pa
import time
from datetime import datetime

pa.PAUSE = 1

HORA_INICIO = "08:12"
HORA_FIM = "18:00"

# Aguarda chegar o horário de início
while True:
    agora = datetime.now().strftime("%H:%M")

    if HORA_INICIO <= agora < HORA_FIM:
        print(f"Iniciando automação às {agora}")
        break

    print(f"Aguardando 08:12... Horário atual: {agora}")
    time.sleep(30)


