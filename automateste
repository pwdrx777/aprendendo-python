# ATUALIZA O DASHBOARD
# =========================

while True:

    agora = datetime.now().strftime("%H:%M")

    # Chegou às 18:00
    if agora >= HORA_FIM:
        print("18:00"
              " - Encerrando automação e fechando o navegador.")

        # Fecha a janela atual do Edge
